{
  "expo": {
    "name": "UrbanFix AI",
    "slug": "expo1",
    "version": "1.1.0",
    "scheme": "urbanfix",
    "orientation": "portrait",
    "icon": "./assets/logo2.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.urbanfix.ai"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.urbanfix.ai",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyApHoIvTWWPC84MhWG6vnE4kfT_J63bprU"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo2.png",
        "backgroundColor": "#000000"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "urbanfix",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo2.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo2.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-web-browser"
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo2.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e10bf0f2-5df8-407f-b75d-042ea8f2a036"
      }
    },
    "owner": "shashiiiii"
  }
}
